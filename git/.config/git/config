[core]
  excludesfile = ~/.config/git/ignore
[user]
  name = Andrew Sutherland
  email = sutherlanda@gmail.com
[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  last = log -1 HEAD
  setworkemail = "config user.email 'andrew.sutherland@zesty.ai'"
  setpersonalemail = "config user.email 'sutherlanda@gmail.com'"
  changeremotehost = !sh -c \"git remote -v | grep '$1.*fetch' | sed s/..fetch.// | sed s/$1/$2/ | xargs git remote set-url\"
  switchwork = "!f() { git remote set-url origin \"$(git remote get-url origin | sed -E 's/@github\\.com[^:]*:/@github.com-zestyai:/')\" && git setworkemail; }; f"
  switchpersonal = "!f() { git remote set-url origin \"$(git remote get-url origin | sed -E 's/@github\\.com[^:]*:/@github.com-personal:/')\" && git setpersonalemail; }; f"
[push]
  default = simple
  
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
