# UseKeychain is macOS-only; ignore it elsewhere (WSL/Linux)
IgnoreUnknown UseKeychain

Host *
  AddKeysToAgent yes
  UseKeychain yes

# Personal account (also the default for plain github.com)
Host github.com github.com-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes

# Zesty work account
Host github.com-zestyai
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_zestyai
  IdentitiesOnly yes
