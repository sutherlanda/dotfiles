#!/usr/bin/env bash
set -euo pipefail

# Clone zestyai repos into ~/projects/zesty and keep Claude's cross-repo access
# in sync: every repo there lists all the others under
# permissions.additionalDirectories in its (gitignored) .claude/settings.local.json.
#
# Clones over the github.com-zestyai SSH alias (ssh package), so the work key,
# email and signing key apply. Installs the Node version a repo pins, if any.
# Safe to re-run; existing clones are left alone.
#
# Usage: zesty-clone <repo> [<repo> ...]
#        zesty-clone --sync     # only re-sync access across existing repos

ZESTY_DIR="$HOME/projects/zesty"

usage() {
  echo "Usage: zesty-clone <repo> [<repo> ...]"
  echo "       zesty-clone --sync"
  exit 1
}

clone() {
  local repo=$1 dir="$ZESTY_DIR/$1"
  if [ -d "$dir/.git" ]; then
    echo "$repo: already cloned"
    return
  fi
  git clone -q "git@github.com-zestyai:zestyai/$repo.git" "$dir"
  echo "$repo: cloned ($(git -C "$dir" rev-parse --abbrev-ref HEAD) @ $(git -C "$dir" log -1 --format=%h))"

  # fnm install reads .node-version / .nvmrc when given no version
  if command -v fnm >/dev/null && { [ -f "$dir/.nvmrc" ] || [ -f "$dir/.node-version" ]; }; then
    (cd "$dir" && fnm install >/dev/null 2>&1) \
      && echo "$repo: Node $(cat "$dir/.nvmrc" "$dir/.node-version" 2>/dev/null | head -1) installed" \
      || echo "$repo: couldn't install its pinned Node version with fnm"
  fi
}

sync_access() {
  local repos=() r o others f
  for r in "$ZESTY_DIR"/*/; do
    [ -d "$r.git" ] && repos+=("$(basename "$r")")
  done
  [ ${#repos[@]} -gt 1 ] || return 0

  for r in "${repos[@]}"; do
    git -C "$ZESTY_DIR/$r" check-ignore -q .claude/settings.local.json \
      || echo "warning: $r doesn't ignore .claude/settings.local.json"
    others=$(for o in "${repos[@]}"; do
      if [ "$o" != "$r" ]; then echo "$ZESTY_DIR/$o"; fi
    done | jq -R . | jq -s .)
    f="$ZESTY_DIR/$r/.claude/settings.local.json"
    mkdir -p "$(dirname "$f")"
    # Merge, so other local settings (e.g. enabledMcpjsonServers) are kept
    { [ -f "$f" ] && cat "$f" || echo '{}'; } \
      | jq --argjson o "$others" \
        '.permissions.additionalDirectories = ((.permissions.additionalDirectories // []) + $o | unique)' \
        >"$f.tmp"
    mv "$f.tmp" "$f"
  done
  echo "Cross-repo access synced across ${#repos[@]} repos in $ZESTY_DIR"
}

[ $# -gt 0 ] || usage
command -v jq >/dev/null || { echo "zesty-clone needs jq" >&2; exit 1; }
mkdir -p "$ZESTY_DIR"

if [ "$1" = "--sync" ]; then
  [ $# -eq 1 ] || usage
else
  for repo in "$@"; do
    case "$repo" in -*|*/*) usage ;; esac
    clone "$repo"
  done
fi
sync_access
