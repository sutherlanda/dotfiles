#!/usr/bin/env bash

# Create and attach/switch to a tmux session.
# Usage: session [name] [path]

SESSION_NAME="${1:-new}"
SESSION_DIR="${2:-$HOME}"

if [ ! -d "$SESSION_DIR" ]; then
  echo "Directory does not exist: $SESSION_DIR"
  exit 1
fi

if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  tmux -u new-session -d -s "$SESSION_NAME" -c "$SESSION_DIR" -n "main"
fi

tmux -u switch-client -t "$SESSION_NAME" 2>/dev/null || exec tmux -u attach-session -t "$SESSION_NAME"
